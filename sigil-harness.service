[Unit]
Description=Private Sigil browser adapter (operator supplied)
After=network-online.target sigil-display.service
Wants=network-online.target sigil-display.service

[Service]
Type=simple
User=sigil
WorkingDirectory=/opt/sigil-agent
EnvironmentFile=/opt/sigil-agent/.env
Environment=DISPLAY=:99
ExecStart=/usr/bin/node /opt/sigil-agent/harness.js
Restart=always
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
