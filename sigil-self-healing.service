[Unit]
Description=Sigil isolated repair candidate worker
After=network-online.target sigil-agent.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sigil-self-healing
EnvironmentFile=/etc/sigil-self-healing.env
Environment=SIGIL_DIR=/opt/sigil-agent
Environment=SIGIL_SELF_HEAL=1
Environment=SELF_HEAL_AUTO_DEPLOY=1
ExecStart=/opt/sigil-self-healing/runtime/bin/node /opt/sigil-self-healing/self-evolution-runner.js
Restart=on-failure
RestartSec=30
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
