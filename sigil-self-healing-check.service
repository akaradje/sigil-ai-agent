[Unit]
Description=Daily isolated Sigil self-healing exercise
After=network-online.target sigil-agent.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sigil-self-healing
ExecStart=/opt/sigil-self-healing/runtime/bin/node /opt/sigil-self-healing/self-healing-check.js
ExecStopPost=/opt/sigil-self-healing/runtime/bin/node /opt/sigil-self-healing/self-healing-check.js --finalize
TimeoutStartSec=1200
TimeoutStopSec=20
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=25
IOWeight=25
MemoryMax=1536M
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/asteria/sigil /opt/sigil-self-healing
ReadWritePaths=/var/lib/sigil-self-healing-e2e /var/lib/sigil-self-healing-reports

