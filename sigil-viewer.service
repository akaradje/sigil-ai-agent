[Unit]
Description=Sigil read-only live viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sigil
WorkingDirectory=/opt/sigil-agent
EnvironmentFile=/opt/sigil-agent/.env
ExecStart=/usr/bin/node /opt/sigil-agent/viewer.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
