# Examples only. Copy to .env and fill values locally. Never commit the real file.
META_API_KEY=
AGENT_BASE=https://api.meta.ai/v1
AGENT_MODEL=muse-spark-1.3-contributor
AGENT_TRANSPORT=curl
AGENT_RELAY_KEY=

# Browser harness must listen on loopback only. See docs/harness-api.md.
HARNESS=http://127.0.0.1:4799
DISPLAY=:99
# AGENT_DIR identifies source code. SIGIL_STATE_DIR is an absolute external state path.
# Set the same state/config paths for every service after migrating existing memory.
SIGIL_STATE_DIR=
SIGIL_CONFIG_DIR=
AGENT_PORT=4801

# Create a random token of at least 24 characters; the viewer refuses an empty token.
VIEWER_TOKEN=
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8080
AGENT_URL=http://127.0.0.1:4801

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional clean URL protected by your reverse proxy. No token/query string allowed here.
VIEWER_PUBLIC_URL=
# Opt-in only. Requires a separately configured sigil-harness.service and permissions.
HARNESS_RESTART_SYSTEMD=0

# Opt in after configuring a compatible harness. Crystal spending remains disabled at 0.
SIGIL_AUTONOMY=0
# Focus on measured EXP routes; defer secondary material/forge detours until cap.
SIGIL_LEVELING_FOCUS=0
SIGIL_LEVELING_MAX_GAP=3
GOLD_RESERVE=100000
CBT_CRYSTAL_BUDGET=0
# Read-only HTTP availability check. Three failures pause controls; two successes resume.
GAME_HEALTH_URL=https://sigil-online.shop/
# Browser age, not agent uptime. Deferred until verified town services finish (6–8 hours).
SESSION_REFRESH_HOURS=6
# Requires SIGIL_AUTONOMY=1. Learns bounded strategies; runtime memory remains private.
SIGIL_DNA=1
# Read-only world knowledge, guarded idle combat probes and opportunity detection.
SIGIL_PROACTIVE=0
# Separate Linux worker. Automatic deployment also requires the flag below and rollback timer.
SIGIL_SELF_HEAL=0
# Apply passing patches and monitor them for ten minutes, with a separate rollback timer.
SELF_HEAL_AUTO_DEPLOY=0
# Enable bounded feature/strategy jobs in the separate root worker.
SELF_HEAL_PROACTIVE=0
# Requires root-owned publication checkout and a repository-specific deploy key.
SELF_HEAL_GIT_PUBLISH=0
# Optional worker state directory, outside the public checkout and readable only by root.
SELF_HEAL_DIR=/var/lib/sigil-self-healing

# Optional, explicit authorization to sell verified plain surplus at NPC shops.
SIGIL_SELL_SURPLUS=0
SIGIL_POWER_PROGRESSION=0
# Focus missing usable wings before routine EXP and reserve their recipe resources.
SIGIL_WING_PRIORITY=0
# Level ranking objective: 5 or 10.
SIGIL_TARGET_RANK=10
